{
  "name": "prode-mundial-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx watch src/app.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/.bin/tsc",
    "start": "node dist/app.js",
    "db:generate": "cross-env NODE_OPTIONS=--max-old-space-size=4096 prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.14.0",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "tsx": "^4.15.1"
  }
}
