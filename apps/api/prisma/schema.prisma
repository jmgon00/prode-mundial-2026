generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  leagueMemberships LeagueMember[]
  predictions       Prediction[]
  badges            Badge[]
}

model League {
  id            String   @id @default(uuid())
  name          String
  inviteCode    String   @unique
  ownerId       String
  tournament    String   @default("MUNDIAL_2026")
  scoringConfig Json     @default("{}")
  createdAt     DateTime @default(now())

  members     LeagueMember[]
  penalties   Penalty[]
  predictions Prediction[]
}

model LeagueMember {
  id          String   @id @default(uuid())
  leagueId    String
  userId      String
  role        Role     @default(MEMBER)
  totalPoints Int      @default(0)
  joinedAt    DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
}

enum Role {
  OWNER
  MEMBER
}

model Penalty {
  id          String      @id @default(uuid())
  leagueId    String
  description String
  position    Int
  type        PenaltyType @default(PENALTY)
  assignedTo  String?

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
}

enum PenaltyType {
  REWARD
  PENALTY
}

model Match {
  id        String      @id @default(uuid())
  stage     Stage
  group     String?
  homeTeam  String
  awayTeam  String
  matchDate DateTime
  homeScore Int?
  awayScore Int?
  status    MatchStatus @default(SCHEDULED)
  isActive  Boolean     @default(false)

  predictions Prediction[]
}

enum Stage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  THIRD_PLACE
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Prediction {
  id                 String   @id @default(uuid())
  userId             String
  matchId            String
  leagueId           String
  predictedHomeScore Int
  predictedAwayScore Int
  pointsEarned       Int?
  createdAt          DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId, leagueId])
}

model Badge {
  id       String    @id @default(uuid())
  userId   String
  leagueId String
  type     BadgeType
  matchId  String?
  earnedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BadgeType {
  EXACT_SCORE
  THREE_IN_A_ROW
  FLAWLESS_GROUP_STAGE
  DARK_HORSE
  WOODEN_SPOON
}
